# Copy to .env and fill in real values. NEVER commit .env.
# DATABASE_URL can be:
#   Supabase pooler (recommended for new projects):
#     postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#   Supabase direct connection:
#     postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#   SQLite fallback:
#     sqlite:///./epiwatch.db
DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<ANON_KEY>
NASA_API_KEY=<NASA_POWER_API_KEY>
FRONTEND_ORIGIN=http://localhost:3000
