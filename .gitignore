# ── Secrets (NEVER commit) ──────────────────────────
backend/.env
frontend/.env.local
frontend/.env
*.local

# ── Python ──────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/

# ── Node ────────────────────────────────────────────
node_modules/
.next/
out/

# ── ML models (regenerable via training pipeline) ──
ml/models/*.pkl

# ── Large raw/processed data (regenerable via ETL) ─
data/raw/climate/*.json
data/raw/climate/*.csv
data/processed/*.parquet
data/processed/*.csv

# ── Keep these tracked (small, hand-curated) ────────
!data/district_crosswalk.csv

# ── Logs & temp ─────────────────────────────────────
*.log
backend/scripts/e2e_results.json

# ── OS artifacts ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Gemini agent workspace ──────────────────────────
.agents/
.claude/
skills-lock.json
